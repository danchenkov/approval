<%# A partial starts with _. Both new and edit render this shared form. %>
<%# form_with chooses POST for a new row and PATCH for an existing row, and adds CSRF protection. %>
<%= form_with(model: request) do |form| %>
  <%# Validation errors belong to the unsaved/invalid model, not a separate error page. %>
  <% if request.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(request.errors.count, "error") %> prohibited this request from being saved:</h2>

      <ul>
        <% request.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :requester_email, style: "display: block" %>
    <%= form.email_field :requester_email %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
