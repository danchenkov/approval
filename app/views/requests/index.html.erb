<%# content_for supplies the browser-tab title used by the shared layout. %>

<% content_for :title, "Requests" %>

<h1>Requests</h1>

<div id="requests">
  <%# Loop over the collection loaded by index; render selects the model partial. %>
  <% @requests.each do |request| %>
    <%= render request %>
    <p>
      <%= link_to "Show this request", request %>
    </p>
  <% end %>
</div>

<%= link_to "New request", new_request_path %>
