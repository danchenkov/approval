<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Approval" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Approval">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <%# The layout wraps every page. Named route helpers avoid hard-coded URLs. %>
    <header>
      <nav aria-label="Main navigation">
        <strong>Approval training</strong>
        <%= link_to "Requests", requests_path %>
        <%= link_to "Reviewers", reviewers_path %>
        <%= link_to "Decisions", decisions_path %>
      </nav>
    </header>
    <main>
      <%# Flash messages survive one redirect, then disappear on the next request. %>
      <% if notice.present? %><p class="notice" role="status"><%= notice %></p><% end %>
      <% if alert.present? %><p class="alert" role="alert"><%= alert %></p><% end %>
      <%# yield inserts the current action's rendered view into this common shell. %>
      <%= yield %>
    </main>
  </body>
</html>
